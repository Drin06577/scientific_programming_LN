# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI — used for LLM-based feature extraction (src/llm_helper.py)
OPENAI_API_KEY=sk-your-key-here
MODEL=gpt-4o-mini

# SQLite
DB_PATH=./housing.db

# Scraper target (Swiss real estate listings)
# flatfox.ch returns server-rendered HTML on detail pages; the scraper uses
# its public JSON index for URL discovery, then parses each detail page
# with requests + BeautifulSoup.
TARGET_URL=https://flatfox.ch
